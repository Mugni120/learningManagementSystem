<%- include('../partials/header') %>
<a class="back-link" href="/instructor/courses/<%= course.id %>">&larr; Kembali ke course</a>
<div class="page-head">
  <h1>Peserta: <%= course.title %></h1>
</div>
<% if (msg) { %><div class="alert alert-success"><%= msg %></div><% } %>
<% if (!enrollments.length) { %>
  <div class="card"><p class="muted">Belum ada siswa yang enroll ke course ini.</p></div>
<% } else { %>
<table class="table">
  <thead>
    <tr><th>Nama</th><th>Email</th><th>Progress</th><th>Status</th></tr>
  </thead>
  <tbody>
  <% enrollments.forEach(function (e) { %>
    <tr>
      <td><strong><%= e.student_name %></strong></td>
      <td class="muted"><%= e.student_email %></td>
      <td>
        <div class="progress-bar" style="margin: 0;"><div class="progress-fill" style="width: <%= e.lesson_total ? Math.round((e.lesson_done / e.lesson_total) * 100) : 0 %>%"></div></div>
        <span class="muted" style="font-size: 0.8rem;"><%= e.lesson_done %>/<%= e.lesson_total %></span>
      </td>
      <td><span class="status-badge <%= e.status === 'completed' ? 'status-completed' : 'status-active' %>"><%= e.status === 'completed' ? 'Selesai' : 'Aktif' %></span></td>
    </tr>
  <% }); %>
  </tbody>
</table>
<% } %>
<%- include('../partials/footer') %>
