<%- include('../partials/header') %>
<div class="page-head"><h1>Ubah Password</h1></div>
<div class="card auth-card wide-card">
  <% if (errors.length) { %>
    <div class="alert alert-error">
      <ul class="alert-list"><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul>
    </div>
  <% } %>
  <form method="POST" action="/profile/password">
    <label>Password Saat Ini</label>
    <input type="password" name="current_password" required>
    <label>Password Baru</label>
    <input type="password" name="new_password" minlength="6" required>
    <label>Konfirmasi Password Baru</label>
    <input type="password" name="confirm_password" minlength="6" required>
    <button class="btn btn-primary btn-block" type="submit">Ubah Password</button>
  </form>
  <div class="action-row" style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border);">
    <a class="btn btn-outline" href="/profile">Kembali ke Profile</a>
  </div>
</div>
<%- include('../partials/footer') %>
