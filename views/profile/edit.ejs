<%- include('../partials/header') %>
<div class="page-head"><h1>Edit Profile</h1></div>
<% if (msg) { %><div class="alert alert-success">✅ <%= msg %></div><% } %>
<% if (errors.length) { %>
  <div class="alert alert-error">
    <ul class="alert-list"><% errors.forEach(function (e) { %><li>⚠️ <%= e %></li><% }); %></ul>
  </div>
<% } %>
<div class="card auth-card wide-card">
  <div style="text-align: center; margin-bottom: 24px;">
    <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--primary-light); color: var(--primary-dark); display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; margin: 0 auto 12px;">
      <%= (currentUser.full_name || currentUser.email).charAt(0).toUpperCase() %>
    </div>
    <div class="muted" style="font-size: 0.9rem;"><%= currentUser.email %></div>
  </div>
  <form method="POST" action="/profile">
    <div class="form-row">
      <div>
        <label>Nama Lengkap</label>
        <input name="full_name" value="<%= old.full_name %>" placeholder="Masukkan nama lengkap" required>
      </div>
      <div>
        <label>Email</label>
        <input type="email" name="email" value="<%= old.email %>" placeholder="Masukkan email" required>
      </div>
    </div>
    <button class="btn btn-primary btn-block" type="submit">💾 Simpan Perubahan</button>
  </form>
  <div class="action-row" style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border); justify-content: space-between;">
    <a class="btn btn-outline" href="/profile/password">🔐 Ubah Password</a>
    <a class="btn btn-outline" href="/dashboard">↩ Kembali ke Dashboard</a>
  </div>
</div>
<%- include('../partials/footer') %>
