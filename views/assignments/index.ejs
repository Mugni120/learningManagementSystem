<%- include('../partials/header') %>
<a class="back-link" href="/instructor/courses/<%= course.id %>">&larr; Kembali ke builder</a>
<div class="page-head">
  <h1>Assignments: <%= course.title %></h1>
  <a class="btn btn-primary" href="/instructor/assignments/new?course=<%= course.id %>">+ Assignment Baru</a>
</div>
<% if (msg) { %><div class="alert alert-success"><%= msg %></div><% } %>
<% if (!assignments.length) { %>
  <div class="card"><p class="muted">Belum ada assignment di course ini.</p></div>
<% } else { %>
<table class="table">
  <thead><tr><th>Assignment</th><th>Deadline</th><th>Max score</th><th>Aksi</th></tr></thead>
  <tbody>
  <% assignments.forEach(function (a) { %>
    <tr>
      <td><strong><%= a.title %></strong></td>
      <td><%= a.due_at ? a.due_at.toLocaleString('id-ID') : 'Tanpa deadline' %></td>
      <td><%= a.max_score %></td>
      <td>
        <div class="action-row">
          <a class="btn btn-small" href="/instructor/assignments/<%= a.id %>/submissions">Submissions</a>
          <a class="btn btn-small" href="/instructor/assignments/<%= a.id %>/edit">Edit</a>
          <form method="POST" action="/instructor/assignments/<%= a.id %>/delete" class="inline-form" data-confirm="Hapus assignment ini beserta semua submission?">
            <button class="btn btn-small btn-danger">Hapus</button>
          </form>
        </div>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
<% } %>
<%- include('../partials/footer') %>
