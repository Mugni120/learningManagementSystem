<%- include('../partials/header') %>
<a class="back-link" href="/learn/<%= quiz.course_id %>">&larr; Kembali ke course</a>

<% if (!attempt) { %>
  <div class="empty-state">
    <div class="empty-icon">🧠</div>
    <h3>Belum mengerjakan quiz ini</h3>
    <p>Mulai kuis pertama Anda dan uji pemahaman materi course.</p>
    <% if (attemptsLeft > 0) { %>
      <a class="btn btn-primary btn-block" href="/quizzes/<%= quiz.id %>/take">Kerjakan Sekarang</a>
    <% } else { %>
      <div class="muted">Kesempatan mengerjakan quiz telah habis.</div>
    <% } %>
  </div>
<% } else { %>
  <div class="page-head">
    <h1 style="margin:0;">Hasil: <%= quiz.title %></h1>
    <p class="muted" style="margin:4px 0 0;">Passing score: <strong><%= quiz.passing_score %></strong> &middot; Sisa kesempatan: <strong><%= attemptsLeft %></strong></p>
  </div>

  <!-- Score Card -->
  <div class="card cert-card" style="max-width: 520px; margin: 0 auto 28px; border: 3px solid <%= attempt.passed ? 'var(--success)' : 'var(--danger)' %>;">
    <div class="cert-body" style="padding: 32px 28px; text-align: center;">
      <div style="width: 80px; height: 80px; border-radius: 50%; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; font-size: 36px;
        background: <%= attempt.passed ? 'var(--success-light)' : 'var(--danger-light)' %>; color: <%= attempt.passed ? 'var(--success)' : 'var(--danger)' %>;">
        <%= attempt.passed ? '🎉' : '💪' %>
      </div>
      <h2 style="margin:0 0 8px; font-size: 2.5rem; font-weight: 800;"><%= attempt.score %></h2>
      <div style="display:inline-block; padding: 8px 18px; border-radius: 999px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;
        background: <%= attempt.passed ? 'var(--success-light)' : 'var(--danger-light)' %>; color: <%= attempt.passed ? 'var(--success)' : 'var(--danger)' %>;">
        <%= attempt.passed ? 'LULUS' : 'TIDAK LULUS' %>
      </div>
      <p class="muted" style="margin-top:16px;">Passing score: <strong><%= quiz.passing_score %></strong></p>
      <% if (attemptsLeft > 0 && !attempt.passed) { %>
        <a class="btn btn-outline" href="/quizzes/<%= quiz.id %>/take" style="margin-top:16px;">🔄 Coba Lagi</a>
      <% } %>
    </div>
  </div>

  <!-- Progress Bar Visual -->
  <div class="card" style="max-width: 520px; margin: 0 auto 28px;">
    <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
      <span class="muted">Skor Anda</span>
      <span class="muted" style="font-weight:700;"><%= attempt.score %> / 100</span>
    </div>
    <div class="progress-bar" style="height:14px;">
      <div class="progress-fill" style="width: <%= attempt.score %>%; background: <%= attempt.passed ? 'var(--success)' : 'var(--primary)' %>;"></div>
    </div>
  </div>

  <!-- Answer Review -->
  <h2 class="section-title" style="max-width: 520px; margin: 0 auto 16px;">📝 Pembahasan Jawaban</h2>
  <% attempt.answers.forEach(function (a, i) { %>
    <div class="card module-card" style="max-width: 520px; margin: 0 auto 16px; animation: slideIn 0.4s ease <%= i * 0.15 %>s forwards; opacity: 0; transform: translateY(12px);">
      <div class="module-head" style="padding-bottom:12px; border-bottom:1px solid var(--border); margin-bottom:12px;">
        <h2 style="margin:0; font-size:1rem;"><%= i + 1 %>. <%= a.question_text %></h2>
        <span class="status-badge <%= a.is_correct ? 'status-published' : 'status-archived' %>">
          <%= a.is_correct ? '✓ Benar' : '✗ Salah' %>
        </span>
      </div>
      <div style="display:flex; gap:10px; align-items:flex-start;">
        <span style="font-size:1.2rem;"><%= a.is_correct ? '✓' : '✗' %></span>
        <div style="flex:1;">
          <p style="margin:0 0 4px; color: var(--text-soft); font-size:0.9rem;">Jawaban Anda</p>
          <p style="margin:0; font-weight:600;"><%= a.selected_option_text || '(kosong)' %></p>
          <p style="margin:4px 0 0; color: var(--muted); font-size:0.85rem;">Poin: <strong><%= a.points_earned %></strong>/<%= a.question_points %></p>
        </div>
      </div>
    </div>
  <% }); %>

  <div style="text-align: center; margin-top: 24px;">
    <a class="btn btn-primary" href="/learn/<%= quiz.course_id %>">Kembali ke Course</a>
  </div>
<% } %>

<style>
  .quiz-question-card {
    animation: slideIn 0.4s ease forwards;
    opacity: 0;
    transform: translateY(12px);
  }
  @keyframes slideIn {
    to { opacity: 1; transform: translateY(0); }
  }
  .cert-card {
    position: relative;
    overflow: hidden;
  }
  .cert-card::after {
    content: "";
    position: absolute;
    top: -60px; right: -60px;
    width: 120px; height: 120px;
    background: radial-gradient(circle, rgba(37,99,235,0.15), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }
</style>

<%- include('../partials/footer') %>
