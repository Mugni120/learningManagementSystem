<%- include('../partials/header') %>
<a class="back-link" href="/instructor/courses/<%= course.id %>">&larr; Kembali ke builder</a>
<div class="page-head">
  <h1>Quizzes: <%= course.title %></h1>
  <a class="btn btn-primary" href="/instructor/quizzes/new?course=<%= course.id %>">+ Quiz Baru</a>
</div>
<% if (msg) { %><div class="alert alert-success"><%= msg %></div><% } %>
<% if (!quizzes.length) { %>
  <div class="card"><p class="muted">Belum ada quiz di course ini.</p></div>
<% } else { %>
<table class="table">
  <thead><tr><th>Quiz</th><th>Pertanyaan</th><th>Passing</th><th>Max attempts</th><th>Aksi</th></tr></thead>
  <tbody>
  <% quizzes.forEach(function (q) { %>
    <tr>
      <td><strong><%= q.title %></strong></td>
      <td><%= q.question_count %></td>
      <td><%= q.passing_score %></td>
      <td><%= q.max_attempts %></td>
      <td>
        <div class="action-row">
          <a class="btn btn-small" href="/instructor/quizzes/<%= q.id %>">Kelola Pertanyaan</a>
          <a class="btn btn-small" href="/instructor/quizzes/<%= q.id %>/attempts">Attempts</a>
          <a class="btn btn-small" href="/instructor/quizzes/<%= q.id %>/edit">Edit</a>
          <form method="POST" action="/instructor/quizzes/<%= q.id %>/delete" class="inline-form" data-confirm="Hapus quiz ini beserta pertanyaan dan attempts?">
            <button class="btn btn-small btn-danger">Hapus</button>
          </form>
        </div>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
<% } %>
<%- include('../partials/footer') %>
