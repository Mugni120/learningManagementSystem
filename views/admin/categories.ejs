<%- include('../partials/header') %>
<div class="page-head">
  <h1>Manajemen Kategori</h1>
  <a class="btn btn-primary" href="/admin/categories/new">+ Kategori Baru</a>
</div>
<% if (msg) { %><div class="alert alert-success"><%= msg %></div><% } %>
<% if (!categories.length) { %>
  <div class="card"><p class="muted">Belum ada kategori.</p></div>
<% } else { %>
<table class="table">
  <thead>
    <tr><th>Nama</th><th>Slug</th><th>Aksi</th></tr>
  </thead>
  <tbody>
  <% categories.forEach(function (c) { %>
    <tr>
      <td><strong><%= c.name %></strong></td>
      <td class="muted"><%= c.slug %></td>
      <td>
        <div class="action-row">
          <a class="btn btn-small" href="/admin/categories/<%= c.id %>/edit">Edit</a>
          <form method="POST" action="/admin/categories/<%= c.id %>/delete" class="inline-form" data-confirm="Hapus kategori ini?">
            <button class="btn btn-small btn-danger">Hapus</button>
          </form>
        </div>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
<% } %>
<%- include('../partials/footer') %>
